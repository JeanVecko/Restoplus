{
  "name": "restoplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"src/**/*.md\" \"*.{json,mjs}\" \"docs/**/*.md\" \"prisma/**/*.md\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"src/**/*.md\" \"*.{json,mjs}\" \"docs/**/*.md\" \"prisma/**/*.md\" README.md"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14"
  }
}
