{
  "name": "restoplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "test:unit": "node --test tests/unit/authorization.test.mjs tests/unit/password.test.mjs tests/unit/orders-authorization.test.mjs tests/unit/orders-finance.test.mjs tests/unit/orders-request.test.mjs tests/unit/catalog-request.test.mjs tests/unit/catalog-pricing.test.mjs",
    "test:static:security": "node --test tests/static/schema-migration.test.mjs",
    "test:http:security": "node --test tests/http/security.test.mjs",
    "test:http:orders": "node --test tests/http/orders.test.mjs",
    "test:http:menu": "node --test tests/http/menu.test.mjs",
    "test:postgres:security": "node --test tests/postgres/account-security.integration.test.mjs",
    "test:postgres:orders": "node --test tests/postgres/orders-security.integration.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"src/**/*.md\" \"*.{json,mjs}\" \"docs/**/*.md\" \"prisma/**/*.md\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"src/**/*.md\" \"*.{json,mjs}\" \"docs/**/*.md\" \"prisma/**/*.md\" README.md"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
