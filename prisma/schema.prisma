generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  STOCK_MANAGER

  @@map("membership_role")
}

enum MembershipInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED

  @@map("membership_invitation_status")
}

model Restaurant {
  id          String                 @id @default(uuid()) @db.Uuid
  publicCode  String                 @unique(map: "restaurants_public_code_key") @db.VarChar(24)
  name        String                 @db.VarChar(160)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  users       User[]
  credentials AuthCredential[]
  memberships Membership[]
  sessions    Session[]
  invitations MembershipInvitation[]
  auditEvents SecurityAuditEvent[]
  diningTables DiningTable[]
  orders Order[]
  orderLines OrderLine[]
  kitchenBarTickets KitchenBarTicket[]
  receipts Receipt[]
  payments Payment[]
  orderAuditEvents OrderAuditEvent[]
  menuCategories MenuCategory[]
  menuProducts MenuProduct[]
  menuProductVariants MenuProductVariant[]
  menuProductOptions MenuProductOption[]
  menuProductZonePrices MenuProductZonePrice[]
  stockItems StockItem[]

  @@map("restaurants")
}

model User {
  id                  String                 @id @default(uuid()) @db.Uuid
  restaurantId        String                 @db.Uuid
  displayName         String                 @db.VarChar(160)
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  restaurant          Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credential          AuthCredential?
  membership          Membership?
  sessions            Session[]
  invitationsCreated  MembershipInvitation[] @relation("InvitationCreator")
  invitationsAccepted MembershipInvitation[] @relation("InvitationAccepter")
  auditEvents         SecurityAuditEvent[]
  servedOrders        Order[]                @relation("OrderServer")
  cashierOrders       Order[]                @relation("OrderCashier")
  cancelledOrders     Order[]                @relation("OrderCancelledBy")
  handledTickets      KitchenBarTicket[]      @relation("TicketHandler")
  cashierReceipts     Receipt[]               @relation("ReceiptCashier")
  authorizedDiscounts Receipt[]              @relation("ReceiptDiscountAuthorizer")
  cashierPayments    Payment[]               @relation("PaymentCashier")
  orderAuditEvents   OrderAuditEvent[]        @relation("OrderAuditActor")

  // Composite target for tenant-safe foreign keys.
  @@unique([restaurantId, id], map: "users_restaurant_id_id_key")
  @@index([restaurantId, isActive], map: "users_restaurant_id_active_idx")
  @@map("users")
}

model AuthCredential {
  id              String     @id @default(uuid()) @db.Uuid
  restaurantId    String     @db.Uuid
  userId          String     @unique(map: "auth_credentials_user_id_key") @db.Uuid
  emailNormalized String     @db.VarChar(320)
  passwordHash    String     @db.VarChar(255)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user            User       @relation(fields: [restaurantId, userId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "auth_credentials_restaurant_user_fkey")

  @@unique([restaurantId, id], map: "auth_credentials_restaurant_id_id_key")
  @@unique([restaurantId, emailNormalized], map: "auth_credentials_restaurant_email_key")
  @@unique([restaurantId, userId], map: "auth_credentials_restaurant_user_key")
  @@map("auth_credentials")
}

model Membership {
  id           String         @id @default(uuid()) @db.Uuid
  restaurantId String         @db.Uuid
  userId       String         @unique(map: "memberships_user_id_key") @db.Uuid
  role         MembershipRole
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User           @relation(fields: [restaurantId, userId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "memberships_restaurant_user_fkey")

  @@unique([restaurantId, userId], map: "memberships_restaurant_id_user_id_key")
  @@index([restaurantId, role, isActive], map: "memberships_restaurant_role_active_idx")
  @@map("memberships")
}

model Session {
  id                String     @id @default(uuid()) @db.Uuid
  restaurantId      String     @db.Uuid
  userId            String     @db.Uuid
  tokenHash         String     @unique(map: "sessions_token_hash_key") @db.VarChar(128)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime   @default(now()) @db.Timestamptz(3)
  absoluteExpiresAt DateTime   @db.Timestamptz(3)
  revokedAt         DateTime?  @db.Timestamptz(3)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user              User       @relation(fields: [restaurantId, userId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "sessions_restaurant_user_fkey")

  @@unique([restaurantId, id], map: "sessions_restaurant_id_id_key")
  @@index([restaurantId, userId, revokedAt], map: "sessions_restaurant_user_revoked_idx")
  @@index([absoluteExpiresAt], map: "sessions_absolute_expires_at_idx")
  @@map("sessions")
}

model MembershipInvitation {
  id               String                     @id @default(uuid()) @db.Uuid
  restaurantId     String                     @db.Uuid
  emailNormalized  String                     @db.VarChar(320)
  role             MembershipRole
  tokenHash        String                     @unique(map: "membership_invitations_token_hash_key") @db.VarChar(64)
  status           MembershipInvitationStatus @default(PENDING)
  createdByUserId  String                     @db.Uuid
  acceptedByUserId String?                    @db.Uuid
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime                   @db.Timestamptz(3)
  acceptedAt       DateTime?                  @db.Timestamptz(3)
  cancelledAt      DateTime?                  @db.Timestamptz(3)
  restaurant       Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "membership_invitations_restaurant_fkey")
  creator          User                       @relation("InvitationCreator", fields: [restaurantId, createdByUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "membership_invitations_creator_fkey")
  accepter         User?                      @relation("InvitationAccepter", fields: [restaurantId, acceptedByUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "membership_invitations_accepter_fkey")

  @@index([restaurantId, status, expiresAt], map: "membership_invitations_restaurant_status_expiry_idx")
  @@index([restaurantId, emailNormalized, status], map: "membership_invitations_restaurant_email_status_idx")
  @@map("membership_invitations")
}

model SecurityAuditEvent {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  actorUserId  String?    @db.Uuid
  eventType    String     @db.VarChar(80)
  targetType   String     @db.VarChar(80)
  targetId     String?    @db.Uuid
  details      Json       @default("{}") @db.JsonB
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "security_audit_events_restaurant_fkey")
  actor        User?      @relation(fields: [restaurantId, actorUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "security_audit_events_actor_fkey")

  @@index([restaurantId, createdAt], map: "security_audit_events_restaurant_created_idx")
  @@index([restaurantId, eventType, createdAt], map: "security_audit_events_restaurant_type_created_idx")
  @@map("security_audit_events")
}

enum OrderStatus {
  WAITING_CASHIER
  IN_PREPARATION
  READY
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum OrderStation {
  CUISINE
  BAR

  @@map("order_station")
}

enum TicketStatus {
  PENDING
  IN_PREPARATION
  READY

  @@map("ticket_status")
}

enum PaymentMethod {
  CASH_CDF
  CASH_USD
  MPESA
  ORANGE_MONEY
  AIRTEL_MONEY
  CARD

  @@map("payment_method")
}

enum MenuPreparationStation {
  CUISINE
  BAR

  @@map("menu_preparation_station")
}

enum MenuZone {
  STANDARD
  TERRACE
  VIP

  @@map("menu_zone")
}

enum MenuProductOptionKind {
  INCLUDED
  PAID

  @@map("menu_product_option_kind")
}

model DiningTable {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  tableNumber  String     @db.VarChar(30)
  zone         String     @default("STANDARD") @db.VarChar(30)
  capacity     Int        @default(4)
  status       String     @default("FREE") @db.VarChar(30)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "dining_tables_restaurantId_fkey")
  orders       Order[]

  @@unique([restaurantId, id], map: "dining_tables_restaurant_id_id_key")
  @@unique([restaurantId, tableNumber], map: "dining_tables_restaurant_number_key")
  @@map("dining_tables")
}

model Order {
  id                 String             @id @default(uuid()) @db.Uuid
  restaurantId       String             @db.Uuid
  orderNumber        String             @db.VarChar(32)
  tableId            String?            @db.Uuid
  tableName          String             @db.VarChar(60)
  pricingZone        MenuZone           @default(STANDARD)
  serverUserId       String             @db.Uuid
  status             OrderStatus        @default(WAITING_CASHIER)
  coversCount        Int                @default(1)
  isTakeaway         Boolean            @default(false)
  notes              String?            @db.Text
  cashierValidatedAt DateTime?          @db.Timestamptz(3)
  cashierUserId      String?            @db.Uuid
  cancelledAt        DateTime?          @db.Timestamptz(3)
  cancellationReason String?            @db.Text
  cancelledByUserId  String?            @db.Uuid
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "orders_restaurantId_fkey")
  table              DiningTable?       @relation(fields: [restaurantId, tableId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "orders_table_fkey")
  server             User               @relation("OrderServer", fields: [restaurantId, serverUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "orders_server_user_fkey")
  cashier            User?              @relation("OrderCashier", fields: [restaurantId, cashierUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "orders_cashier_user_fkey")
  cancelledBy        User?              @relation("OrderCancelledBy", fields: [restaurantId, cancelledByUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "orders_cancelled_by_user_fkey")
  lines              OrderLine[]
  tickets            KitchenBarTicket[]
  receipt            Receipt?
  auditEvents        OrderAuditEvent[]

  @@unique([restaurantId, id], map: "orders_restaurant_id_id_key")
  @@unique([restaurantId, orderNumber], map: "orders_restaurant_order_number_key")
  @@index([restaurantId, status, createdAt], map: "orders_restaurant_status_created_idx")
  @@map("orders")
}

model OrderLine {
  id                     String       @id @default(uuid()) @db.Uuid
  restaurantId           String       @db.Uuid
  orderId                String       @db.Uuid
  productId              String       @db.VarChar(64)
  productName            String       @db.VarChar(160)
  station                OrderStation
  quantity               Int          @default(1)
  unitPriceAmount        Decimal      @db.Decimal(12, 2)
  currency               String       @db.VarChar(3)
  selectedAccompaniments Json         @default("[]") @db.JsonB
  selectedExtras         Json         @default("[]") @db.JsonB
  notes                  String?      @db.VarChar(255)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  restaurant             Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "order_lines_restaurantId_fkey")
  order                  Order        @relation(fields: [restaurantId, orderId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "order_lines_restaurant_order_fkey")

  @@unique([restaurantId, id], map: "order_lines_restaurant_id_id_key")
  @@index([restaurantId, orderId], map: "order_lines_restaurant_order_idx")
  @@map("order_lines")
}

model KitchenBarTicket {
  id              String       @id @default(uuid()) @db.Uuid
  restaurantId    String       @db.Uuid
  orderId         String       @db.Uuid
  ticketNumber    String       @db.VarChar(36)
  station         OrderStation
  status          TicketStatus @default(PENDING)
  itemsSummary    Json         @default("[]") @db.JsonB
  issuedAt        DateTime     @default(now()) @db.Timestamptz(3)
  readyAt         DateTime?    @db.Timestamptz(3)
  handledByUserId String?      @db.Uuid
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "kitchen_bar_tickets_restaurantId_fkey")
  order           Order        @relation(fields: [restaurantId, orderId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "kitchen_bar_tickets_restaurant_order_fkey")
  handledBy       User?        @relation("TicketHandler", fields: [restaurantId, handledByUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "kitchen_bar_tickets_handled_by_user_fkey")

  @@unique([restaurantId, id], map: "kitchen_bar_tickets_restaurant_id_id_key")
  @@unique([restaurantId, ticketNumber], map: "kitchen_bar_tickets_restaurant_ticket_number_key")
  @@unique([restaurantId, orderId, station], map: "kitchen_bar_tickets_restaurant_order_station_key")
  @@index([restaurantId, station, status], map: "kitchen_bar_tickets_restaurant_station_status_idx")
  @@map("kitchen_bar_tickets")
}

model Receipt {
  id                         String        @id @default(uuid()) @db.Uuid
  restaurantId               String        @db.Uuid
  orderId                    String        @unique(map: "receipts_order_id_key") @db.Uuid
  receiptNumber              String        @db.VarChar(32)
  discountAmount             Decimal?      @db.Decimal(12, 2)
  discountCurrency           String?       @db.VarChar(3)
  discountReason             String?       @db.Text
  discountAuthorizedByUserId String?       @db.Uuid
  isSettled                  Boolean       @default(false)
  cashierUserId              String        @db.Uuid
  createdAt                  DateTime      @default(now()) @db.Timestamptz(3)
  settledAt                  DateTime?     @db.Timestamptz(3)
  restaurant                 Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "receipts_restaurantId_fkey")
  order                      Order         @relation(fields: [restaurantId, orderId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "receipts_restaurant_order_fkey")
  cashier                    User          @relation("ReceiptCashier", fields: [restaurantId, cashierUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "receipts_cashier_user_fkey")
  discountAuthorizedBy       User?         @relation("ReceiptDiscountAuthorizer", fields: [restaurantId, discountAuthorizedByUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "receipts_discount_authorizer_user_fkey")
  payments                   Payment[]

  @@unique([restaurantId, id], map: "receipts_restaurant_id_id_key")
  @@unique([restaurantId, orderId], map: "receipts_restaurant_order_id_key")
  @@unique([restaurantId, receiptNumber], map: "receipts_restaurant_receipt_number_key")
  @@index([restaurantId, isSettled, createdAt], map: "receipts_restaurant_settled_idx")
  @@map("receipts")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  restaurantId    String        @db.Uuid
  receiptId       String        @db.Uuid
  paymentMethod   PaymentMethod
  amountPaid      Decimal       @db.Decimal(12, 2)
  currencyPaid    String        @db.VarChar(3)
  referenceNumber String?       @db.VarChar(100)
  cashierUserId   String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "payments_restaurantId_fkey")
  receipt         Receipt       @relation(fields: [restaurantId, receiptId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "payments_restaurant_receipt_fkey")
  cashier         User          @relation("PaymentCashier", fields: [restaurantId, cashierUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "payments_cashier_user_fkey")

  @@unique([restaurantId, id], map: "payments_restaurant_id_id_key")
  @@index([restaurantId, receiptId], map: "payments_restaurant_receipt_idx")
  @@map("payments")
}

model OrderAuditEvent {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  orderId      String     @db.Uuid
  actorUserId  String     @db.Uuid
  eventType    String     @db.VarChar(60)
  details      Json       @default("{}") @db.JsonB
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "order_audit_events_restaurantId_fkey")
  order        Order      @relation(fields: [restaurantId, orderId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "order_audit_events_restaurant_order_fkey")
  actor        User       @relation("OrderAuditActor", fields: [restaurantId, actorUserId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "order_audit_events_restaurant_actor_fkey")

  @@unique([restaurantId, id], map: "order_audit_events_restaurant_id_id_key")
  @@index([restaurantId, orderId, createdAt], map: "order_audit_events_restaurant_order_created_idx")
  @@index([restaurantId, createdAt], map: "order_audit_events_restaurant_created_idx")
  @@map("order_audit_events")
}

model MenuCategory {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @db.Uuid
  name         String        @db.VarChar(100)
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "menu_categories_restaurant_fkey")
  products     MenuProduct[]

  @@unique([restaurantId, id], map: "menu_categories_restaurant_id_id_key")
  @@index([restaurantId, isActive, displayOrder], map: "menu_categories_restaurant_active_order_idx")
  @@map("menu_categories")
}

model MenuProduct {
  id                   String                  @id @default(uuid()) @db.Uuid
  restaurantId         String                  @db.Uuid
  categoryId           String                  @db.Uuid
  name                 String                  @db.VarChar(160)
  description          String?                 @db.VarChar(1000)
  preparationStation   MenuPreparationStation
  currency             String                  @db.VarChar(3)
  standardPriceAmount  Decimal                 @db.Decimal(12, 2)
  isAvailable           Boolean                 @default(true)
  isDailySpecial        Boolean                 @default(false)
  displayOrder          Int                     @default(0)
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  restaurant            Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "menu_products_restaurant_fkey")
  category              MenuCategory            @relation(fields: [restaurantId, categoryId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "menu_products_category_fkey")
  variants              MenuProductVariant[]
  options               MenuProductOption[]
  zonePrices            MenuProductZonePrice[]

  @@unique([restaurantId, id], map: "menu_products_restaurant_id_id_key")
  @@unique([restaurantId, id, currency], map: "menu_products_restaurant_id_currency_key")
  @@index([restaurantId, categoryId, isActive, displayOrder], map: "menu_products_restaurant_category_order_idx")
  @@index([restaurantId, isActive, isAvailable], map: "menu_products_restaurant_active_available_idx")
  @@map("menu_products")
}

model MenuProductVariant {
  id                  String                  @id @default(uuid()) @db.Uuid
  restaurantId        String                  @db.Uuid
  productId           String                  @db.Uuid
  name                String                  @db.VarChar(100)
  standardPriceAmount Decimal                 @db.Decimal(12, 2)
  isAvailable         Boolean                 @default(true)
  displayOrder        Int                     @default(0)
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  restaurant          Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "menu_product_variants_restaurant_fkey")
  product             MenuProduct             @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "menu_product_variants_product_fkey")
  zonePrices          MenuProductZonePrice[]

  @@unique([restaurantId, id], map: "menu_product_variants_restaurant_id_id_key")
  @@unique([restaurantId, productId, id], map: "menu_product_variants_restaurant_product_id_key")
  @@index([restaurantId, productId, isActive, displayOrder], map: "menu_product_variants_product_order_idx")
  @@map("menu_product_variants")
}

model MenuProductOption {
  id           String                 @id @default(uuid()) @db.Uuid
  restaurantId String                 @db.Uuid
  productId    String                 @db.Uuid
  name         String                 @db.VarChar(120)
  kind         MenuProductOptionKind
  priceAmount  Decimal                @db.Decimal(12, 2)
  currency     String                 @db.VarChar(3)
  isAvailable  Boolean                @default(true)
  displayOrder Int                    @default(0)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)
  restaurant   Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "menu_product_options_restaurant_fkey")
  product      MenuProduct            @relation(fields: [restaurantId, productId, currency], references: [restaurantId, id, currency], onDelete: Restrict, onUpdate: Cascade, map: "menu_product_options_product_currency_fkey")

  @@unique([restaurantId, id], map: "menu_product_options_restaurant_id_id_key")
  @@index([restaurantId, productId, isActive, isAvailable], map: "menu_product_options_product_active_idx")
  @@map("menu_product_options")
}

model MenuProductZonePrice {
  id           String             @id @default(uuid()) @db.Uuid
  restaurantId String             @db.Uuid
  productId    String             @db.Uuid
  variantId    String?            @db.Uuid
  zone         MenuZone
  priceAmount  Decimal            @db.Decimal(12, 2)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "menu_product_zone_prices_restaurantId_fkey")
  product      MenuProduct        @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Cascade, map: "menu_product_zone_prices_product_fkey")
  variant      MenuProductVariant? @relation(fields: [restaurantId, productId, variantId], references: [restaurantId, productId, id], onDelete: Restrict, onUpdate: Cascade, map: "menu_product_zone_prices_variant_fkey")

  @@unique([restaurantId, id], map: "menu_product_zone_prices_restaurant_id_id_key")
  @@index([restaurantId, productId, zone, isActive], map: "menu_product_zone_prices_product_lookup_idx")
  @@index([restaurantId, productId, variantId, zone, isActive], map: "menu_product_zone_prices_variant_lookup_idx")
  @@map("menu_product_zone_prices")
}

model StockItem {
  id          String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  name        String   @db.VarChar(160)
  unit        String   @db.VarChar(30)
  quantity    Decimal  @db.Decimal(12, 3)
  threshold   Decimal  @db.Decimal(12, 3)
  currency    String   @db.VarChar(3)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "stock_items_restaurantId_fkey")

  @@unique([restaurantId, id], map: "stock_items_restaurant_id_id_key")
  @@unique([restaurantId, name], map: "stock_items_restaurant_name_key")
  @@index([restaurantId, isActive], map: "stock_items_restaurant_active_idx")
  @@map("stock_items")
}
