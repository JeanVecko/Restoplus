# Copy this file to .env and replace placeholders locally; never share real URLs.
# Keep migration, application, and authentication PostgreSQL roles separate.
MIGRATION_DATABASE_URL="postgresql://restoplus_migrator:CHANGE_ME@127.0.0.1:5432/restoplus_dev?schema=public"
APP_DATABASE_URL="postgresql://restoplus_app:CHANGE_ME@127.0.0.1:5432/restoplus_dev?schema=public"
AUTH_DATABASE_URL="postgresql://restoplus_auth:CHANGE_ME@127.0.0.1:5432/restoplus_dev?schema=public"
